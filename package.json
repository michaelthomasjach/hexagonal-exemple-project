{
  "name": "hexagonal-exemple-project",
  "version": "1.0.0",
  "description": "Exemple minimal d'architecture hexagonale (ports et adaptateurs) en Node.js et TypeScript : on construit une voiture avec quatre roues, un volant et un moteur.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "keywords": [
    "architecture-hexagonale",
    "ports-and-adapters",
    "typescript",
    "nodejs",
    "exemple"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
